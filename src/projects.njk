---
layout: layouts/card-page.njk
title: projects
cardNum: 2
cardTitle: projects
---
<h2>◆ Projects ◆</h2>
<p class="projects-intro">Public open-source things I've built or contributed to.</p>

{% for section in projects %}
<section class="projects-section">
  <header class="projects-section-head">
    <img src="/assets/sprites/projects/{{ section.sprite }}.png" alt="" class="projects-section-icon">
    <h3>{{ section.title }}</h3>
  </header>
  <ul class="projects-list">
    {% for item in section.items %}
    <li>
      <a href="{{ item.url }}"><strong>{{ item.name }}</strong></a>
      {%- if item.description %} · {{ item.description }}{% endif %}
      {%- if item.extra %} {{ item.extra.before }} <a href="{{ item.extra.url }}">{{ item.extra.label }}</a>.{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

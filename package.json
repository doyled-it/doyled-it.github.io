{
  "name": "doyled-it",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --quiet",
    "build": "npm run build:bio && npm run build:site && npm run build:resume",
    "build:bio": "node scripts/compile-bio.mjs",
    "build:site": "eleventy",
    "build:resume": "node scripts/build-resume-pdf.mjs",
    "build:resume:wip": "node scripts/build-resume-pdf-new.mjs",
    "build:eleventy": "npm run build:bio && npm run build:site",
    "update:stats": "npm run update:baseball && npm run update:golf",
    "update:baseball": "node scripts/sync-stats.mjs --skip-golf-fetch",
    "update:golf": "node scripts/fetch-golf.mjs",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "canvas": "^3.2.3",
    "hackmyresume": "^1.9.0-beta",
    "jsonresume-theme-full-of-it": "file:./vendor/jsonresume-theme-full-of-it",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.40.0",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "dotenv": "^17.4.2",
    "ghin": "github:doyled-it/ghin#doyled-it-patches",
    "nsf-player": "^1.2.0"
  }
}
